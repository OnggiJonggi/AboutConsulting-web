<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.axaboutconsulting.student.TargetInfoMapper">
	<insert id="insertTargetUniv" parameterType="TargetInfoUpdate" >
		insert all
		<foreach collection="targetPair" item="pair">
			into TARGET_INFO (STUDENT_NO, MAJOR, UNIV)
			values (#{studentNo}, #{pair.major}, #{pair.univ})
		</foreach>
		select * from dual
	</insert>
</mapper>
