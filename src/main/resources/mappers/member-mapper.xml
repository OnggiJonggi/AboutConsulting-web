<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="memberMapper">

	<resultMap id="memberDetailMap" type="Member$Detail">
	    <result property="userNo" column="MEMBERS_NO"/>
	    <result property="userId" column="ID"/>
	    <result property="userPwd" column="PWD"/>
	    <result property="name" column="NAME"/>
	    <result property="nickName" column="NICK_NAME"/>
	</resultMap>

	<select id="selectMemberById" parameterType="string" resultType="memberDetailMap" >
		select
			MEMBERS_NO
			,ID
			,PWD
			,NAME
			,NICK_NAME
		from MEMBERS
		where ID = #{userId}
	</select>
	
	<insert id="insertMember" parameterType="Member$newAccount" >
		<selectKey keyProperty="memberNo" resultType="int" order="BEFORE">
			SELECT SEQ_MEMBERS.nextval FROM DUAL
		</selectKey>
		insert into MEMBERS (
			MEMBER_NO
			,ID
			,PWD
			,NAME
			,NICK_NAME
			)
		values
			#{memberNo}
			,#{userId}
			,#{userPwd}
			,#{name}
			,#{nickName}
	</insert>
</mapper>
