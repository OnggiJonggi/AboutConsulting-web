<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.axaboutconsulting.member.MemberMapper">

	<resultMap id="memberDetailMap" type="MemberDetail">
	    <result property="memberNo" column="MEMBERS_NO"/>
	    <result property="userId" column="ID"/>
	    <result property="userPwd" column="PWD"/>
	    <result property="name" column="NAME"/>
	    <result property="nickname" column="NICKNAME"/>
	    <result property="role" column="ROLE"/>
	</resultMap>
	<resultMap id="memberJoinMap" type="MemberJoin">
	    <result property="memberNo" column="MEMBERS_NO"/>
	    <result property="userId" column="ID"/>
	    <result property="userPwd" column="PWD"/>
	    <result property="name" column="NAME"/>
	    <result property="nickname" column="NICKNAME"/>
	</resultMap>

	<select id="selectMemberById" parameterType="memberDetailMap" resultType="string" >
		select
			MEMBERS_NO
			,ID
			,PWD
			,NAME
			,NICKNAME
			,ROLE
		from MEMBER
		where ID = #{userId}
	</select>
	
	<insert id="insertJoin" parameterType="memberJoinMap" >
		<selectKey keyProperty="memberNo" resultType="int" order="BEFORE">
			SELECT SEQ_MEMBER.nextval FROM DUAL
		</selectKey>
		insert into MEMBER (
			MEMBER_NO
			,ID
			,PWD
			,NAME
			,NICKNAME
			)
		values
			#{memberNo}
			,#{userId}
			,#{userPwd}
			,#{name}
			,#{nickname}
	</insert>
	
	<select id="selectCheckId" parameterType="string" resultType="_int" >
		select count(*)
		from MEMBER
		where ID = #{userId}
	</select>
	
	<select id="selectCheckNickname" parameterType="string" resultType="_int" >
		select count(*)
		from MEMBER
		where NICKNAME = #{nickname}
	</select>
	
</mapper>
